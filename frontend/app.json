{
	"expo": {
		"name": "mywallet",
		"slug": "mywallet",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "mywallet",
		"userInterfaceStyle": "dark",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.mywallet.app"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "com.mywallet.app"
		},
		"web": {
			"bundler": "metro",
			"output": "server",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			],
			"expo-secure-store",
			"expo-font",
			"expo-image",
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "936090a7-7bc3-4610-a2b6-e9be11d6edd2"
			}
		}
	}
}
